{
  "name": "@agent-surface/webmcp",
  "version": "0.14.0",
  "description": "[Experimental] WebMCP (navigator.modelContext) transport adapter for agent-surface",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/copy-license.cjs",
    "size": "size-limit"
  },
  "dependencies": {
    "@agent-surface/core": "workspace:^"
  },
  "devDependencies": {
    "@agent-surface/testing": "workspace:*",
    "zod": "^4.1.5"
  },
  "author": "Paolo Barbato",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wiseair-srl/agent-surface.git",
    "directory": "packages/webmcp"
  },
  "homepage": "https://agent-surface-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/Wiseair-srl/agent-surface/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent-surface",
    "agent",
    "ai",
    "llm",
    "frontend",
    "capabilities",
    "typescript",
    "webmcp",
    "mcp",
    "modelcontext"
  ],
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "4 kB",
      "ignore": [
        "@agent-surface/core"
      ]
    }
  ]
}
