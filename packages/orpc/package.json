{
  "name": "@agent-surface/orpc",
  "version": "0.2.0",
  "description": "Contextual references to oRPC domain procedures exposed via orpc-agent — binding, gating, executor bridge",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/copy-license.cjs",
    "size": "size-limit"
  },
  "dependencies": {
    "@agent-surface/core": "workspace:^"
  },
  "peerDependencies": {
    "@agent-surface/react": ">=0.1.0",
    "react": ">=18.2"
  },
  "peerDependenciesMeta": {
    "@agent-surface/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agent-surface/react": "workspace:*",
    "@agent-surface/testing": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@types/react": "^19.1.9",
    "@testing-library/react": "^16.3.0",
    "zod": "^4.1.5"
  },
  "author": "Paolo Barbato",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wiseair-srl/agent-surface.git",
    "directory": "packages/orpc"
  },
  "homepage": "https://agent-surface-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/Wiseair-srl/agent-surface/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent-surface",
    "agent",
    "ai",
    "llm",
    "frontend",
    "capabilities",
    "typescript",
    "orpc",
    "orpc-agent",
    "rpc"
  ],
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "8 kB",
      "ignore": [
        "@agent-surface/core",
        "@agent-surface/react",
        "react"
      ]
    }
  ]
}
