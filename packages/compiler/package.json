{
  "name": "@agent-surface/compiler",
  "version": "0.21.0",
  "description": "Vite compiler for deterministic agent capability contracts",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/copy-license.cjs"
  },
  "dependencies": {
    "@agent-surface/core": "workspace:^",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0"
  },
  "author": "Paolo Barbato",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wiseair-srl/agent-surface.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://agent-surface.dev",
  "bugs": {
    "url": "https://github.com/Wiseair-srl/agent-surface/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent-surface",
    "vite",
    "compiler",
    "capabilities",
    "manifest"
  ]
}
