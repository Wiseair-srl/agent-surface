{
  "name": "@agent-surface/cli",
  "version": "0.11.0",
  "description": "Inspect and check the agent surface your app exposes — in the terminal and in CI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-surface": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/copy-license.cjs"
  },
  "dependencies": {
    "@agent-surface/core": "workspace:^",
    "@agent-surface/react": "workspace:^",
    "@agent-surface/testing": "workspace:^",
    "ink": "^6.3.1",
    "ink-spinner": "^5.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-node": "^3.2.4"
  },
  "peerDependencies": {
    "@testing-library/react": ">=14",
    "react-dom": ">=18.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.9",
    "react-dom": "^19.1.1"
  },
  "author": "Paolo Barbato",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wiseair-srl/agent-surface.git",
    "directory": "packages/cli"
  },
  "homepage": "https://agent-surface-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/Wiseair-srl/agent-surface/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent-surface",
    "cli",
    "agent",
    "ai",
    "llm",
    "frontend",
    "capabilities",
    "inspect",
    "policies"
  ]
}
