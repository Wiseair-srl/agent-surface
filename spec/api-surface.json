{
  "$schema": "./api-surface.schema.json",
  "description": "Public API closure manifest. Every symbol reachable through a published exports map subpath is classified. scripts/check-api-closure.mjs derives the inventory from the built .d.ts files and fails when it drifts from this file. Classifications are stable: reclassifying an export is a reviewable change, never a side effect.",
  "classes": {
    "authority-boundary": "Mints or verifies a CapabilityAuthority.",
    "capability-construction": "Produces a definition, contract or binding that could become an invocable capability.",
    "execution-boundary": "Can cause a capability handler to run.",
    "exposure-boundary": "Projects capabilities to an agent, provider or transport.",
    "introspection-only": "Read-only projection of already-authorized state. Cannot execute or expose.",
    "utility": "No capability semantics: ids, schemas, errors, policies, sinks, constants.",
    "type": "Type-only export. Cannot execute."
  },
  "requires": {
    "authority": "Rejects construction/use without a genuine CapabilityAuthority.",
    "verifies": "Is itself the verification step.",
    "mints": "Produces the authority from a verified manifest.",
    "proof": "Emits or forwards private compiler proof; the value is inert until an authority accepts it.",
    "registry": "Executes only through registry.invoke, which already required authority.",
    "compiler": "Build-time only. Produces the manifest; never executes a capability.",
    "inert": "Reachable but cannot reach execution: no published boundary accepts its output."
  },
  "modules": {
