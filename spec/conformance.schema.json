{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-surface conformance manifest",
  "type": "object",
  "required": ["requirements"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "requirements": {
      "type": "object",
      "patternProperties": {
        "^AS-[A-Z]+-[0-9]{3}$": {
          "type": "object",
          "required": ["title", "source", "status"],
          "properties": {
            "title": { "type": "string", "minLength": 8 },
            "source": {
              "type": "string",
              "pattern": "^[0-9]{2}-[a-z0-9-]+\\.md(#[a-z0-9-]+)?$",
              "description": "docs/ file + optional anchor"
            },
            "decision": { "type": "string", "pattern": "^D[-A-Za-z0-9]+$" },
            "tests": {
              "type": "array",
              "items": { "type": "string", "pattern": "\\.test\\.tsx?$" }
            },
            "status": { "enum": ["implemented", "specified", "deprecated"] },
            "justification": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
